{
  "name": "dsh-websocket2http",
  "version": "0.1.2",
  "description": "将 DSH Web 界面的 WebSocket 实时连接转换为 HTTP 长轮询，支持实时更新、双向流和断线恢复，适配禁用 WebSocket 的代理网络。WebSocket-to-HTTP long polling for DeepSeek Harness.",
  "author": "ZotinColin (wlyzqm)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlyzqm/DSH-WebSocket2HTTP.git"
  },
  "homepage": "https://github.com/wlyzqm/DSH-WebSocket2HTTP#readme",
  "bugs": {
    "url": "https://github.com/wlyzqm/DSH-WebSocket2HTTP/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "websocket",
    "http",
    "long-polling",
    "proxy",
    "实时连接",
    "长轮询",
    "代理兼容"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/VERIFICATION.md"
  ],
  "scripts": {
    "test": "node --test *.test.mjs"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
